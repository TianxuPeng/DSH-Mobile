<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/browser_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/balance_bar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_balance_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />

            <TextView
                style="@style/BalanceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/balance_label" />

            <TextView
                android:id="@+id/balance_amount"
                style="@style/BalanceAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/balance_unknown" />

            <TextView
                android:id="@+id/balance_tier"
                style="@style/TierBadge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tier_unknown"
                android:text="@string/balance_unknown"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/browser_page"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/black"
                android:overScrollMode="never" />

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent"
                android:indeterminateTintMode="src_in"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/browser_error_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_panel"
                android:elevation="14dp"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <View
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:background="@color/accent" />

                <TextView
                    style="@style/PanelTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/browser_error_title" />

                <TextView
                    android:id="@+id/browser_error_detail"
                    style="@style/PanelBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/browser_error_unknown" />

                <Button
                    android:id="@+id/browser_retry"
                    style="@style/PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="@string/browser_error_retry" />

                <Button
                    android:id="@+id/browser_back"
                    style="@style/GhostButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/browser_back_to_scan" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
