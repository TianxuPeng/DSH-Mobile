<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg" />

    <com.dshmobile.app.ScanOverlayView
        android:id="@+id/scan_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="28dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            style="@style/ScannerOverline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scanner_overline" />

        <TextView
            style="@style/ScannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/scanner_title" />

        <TextView
            android:id="@+id/scanner_subtitle"
            style="@style/ScannerSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/scanner_subtitle" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="26dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <Button
            android:id="@+id/continue_button"
            style="@style/GhostButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:minHeight="44dp"
            android:text="@string/continue_last_device"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.02"
            android:text="@string/scanner_hint"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <Button
            android:id="@+id/torch_button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill"
            android:drawableStart="@drawable/ic_flash"
            android:drawablePadding="8dp"
            android:fontFamily="sans-serif-medium"
            android:minHeight="44dp"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@null"
            android:text="@string/torch_on"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_panel"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <View
            android:layout_width="36dp"
            android:layout_height="3dp"
            android:background="@color/accent" />

        <TextView
            android:id="@+id/panel_title"
            style="@style/PanelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/permission_title" />

        <TextView
            android:id="@+id/panel_body"
            style="@style/PanelBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/permission_body" />

        <Button
            android:id="@+id/panel_primary"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="@string/permission_grant" />

        <Button
            android:id="@+id/panel_secondary"
            style="@style/GhostButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/permission_settings"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
